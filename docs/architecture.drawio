d="c51" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1290" y="400" width="22" height="22" as="geometry"/></mxCell><mxCell id="c52" value="CRUD on own&lt;br&gt;userId partition" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1262" y="428" width="110" height="40" as="geometry"/></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="425"/><mxPoint x="1540" y="212"/></Array></mxGeometry></mxCell><mxCell id="c54" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1529" y="318" width="22" height="22" as="geometry"/></mxCell><mxCell id="c55" value="DynamoDB&lt;br&gt;Streams" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1462" y="340" width="72" height="40" as="geometry"/></mxCell><mxCell id="c56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#E7157B;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="failed batches" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#545B64;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1196" y="190" width="100" height="20" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;Request flow&lt;/b&gt;&lt;br&gt;1&amp;nbsp; User authenticates with the Cognito hosted UI and receives a JWT.&lt;br&gt;2&amp;nbsp; Every request hits CloudFront; WAF filters it at the edge.&lt;br&gt;3&amp;nbsp; Static files come from a private S3 bucket (Origin Access Control).&lt;br&gt;4&amp;nbsp; API calls go to API Gateway with a secret key only CloudFront knows.&lt;br&gt;5&amp;nbsp; Cognito authorizer validates the token (401 if missing/invalid).&lt;br&gt;6&amp;ndash;7&amp;nbsp; Lambda reads/writes only the caller's own items.&lt;br&gt;8&amp;nbsp; Changes stream to a processor for auditing and metrics." style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1010" y="590" width="560" height="140" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Every component is traced (X-Ray), logged and alarmed (CloudWatch &amp;rarr; SNS).&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="470" y="796" width="700" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>